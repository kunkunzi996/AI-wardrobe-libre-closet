{{>navbar}}

<main class="p-4 pt-20 pb-24 max-w-3xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <a href="/wardrobe" class="btn btn-ghost btn-sm btn-circle" aria-label="{{t 'lang.BACK'}}">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
    </a>
    <h1 class="text-2xl font-bold flex-1">{{t 'lang.WARDROBE_RECOMMEND_TITLE'}}</h1>
  </div>

  <form method="post" action="/wardrobe/recommend" class="flex flex-col sm:flex-row gap-2 mb-6">
    <input
      type="text"
      name="q"
      value="{{q}}"
      placeholder="{{t 'lang.WARDROBE_RECOMMEND_PLACEHOLDER'}}"
      class="input input-bordered flex-1"
      autofocus
    />
    <button type="submit" class="btn btn-primary">{{t 'lang.WARDROBE_RECOMMEND_ACTION'}}</button>
  </form>

  {{#if result}}
    <div class="mb-4 rounded-lg bg-base-200 p-3 text-sm text-base-content/70">
      {{t 'lang.WARDROBE_RECOMMEND_INTENT'}}
      {{#if result.intent.colors.length}}<span class="badge badge-sm badge-primary ml-1">{{result.intent.colors}}</span>{{/if}}
      {{#if result.intent.styles.length}}<span class="badge badge-sm badge-secondary ml-1">{{result.intent.styles}}</span>{{/if}}
      {{#if result.intent.scenes.length}}<span class="badge badge-sm badge-accent ml-1">{{result.intent.scenes}}</span>{{/if}}
      {{#if result.intent.seasons.length}}<span class="badge badge-sm badge-info ml-1">{{result.intent.seasons}}</span>{{/if}}
    </div>

    {{#if result.groups.length}}
      <div class="space-y-6">
        {{#each result.groups}}
        <section>
          <h2 class="text-sm font-semibold text-base-content/60 mb-3">{{this.categoryLabel}}</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {{#each this.garments}}
            <a href="/wardrobe/{{this.garment.id}}" class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
              <figure class="aspect-square bg-base-200">
                {{#if this.garment.photo}}
                <img src="/file/nobg/{{this.garment.photo.fileName}}" alt="{{this.garment.name}}" class="object-cover w-full h-full" />
                {{else}}
                <div class="flex items-center justify-center w-full h-full text-base-content/30">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-12">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.251 2.251 0 0 1 2.012 1.244l.256.512a2.251 2.251 0 0 0 2.013 1.244h3.218a2.251 2.251 0 0 0 2.013-1.244l.256-.512a2.251 2.251 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3" />
                  </svg>
                </div>
                {{/if}}
              </figure>
              <div class="card-body p-3">
                <h3 class="card-title text-sm">{{this.garment.name}}</h3>
                <p class="text-xs text-base-content/60">{{t 'lang.WARDROBE_RECOMMEND_SCORE'}} {{this.score}}</p>
                <p class="text-xs text-base-content/50">{{this.reasons}}</p>
              </div>
            </a>
            {{/each}}
          </div>
        </section>
        {{/each}}
      </div>
    {{else}}
      <div class="rounded-lg bg-base-200 p-6 text-center text-base-content/50">
        {{t 'lang.WARDROBE_RECOMMEND_NO_MATCH'}}
      </div>
    {{/if}}

    {{#if result.excluded.length}}
    <details class="mt-6">
      <summary class="cursor-pointer text-sm text-base-content/50">{{t 'lang.WARDROBE_RECOMMEND_EXCLUDED'}} {{result.excluded.length}}</summary>
      <div class="mt-2 flex flex-wrap gap-2">
        {{#each result.excluded}}
        <span class="badge badge-outline">{{this.garment.name}} · {{this.reason}}</span>
        {{/each}}
      </div>
    </details>
    {{/if}}
  {{else}}
    <div class="rounded-lg bg-base-200 p-6 text-sm text-base-content/60">
      {{t 'lang.WARDROBE_RECOMMEND_EMPTY_HINT'}}
    </div>
  {{/if}}
</main>

{{>dock}}
