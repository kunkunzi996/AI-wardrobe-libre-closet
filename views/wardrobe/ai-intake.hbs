{{>navbar}}

<main class="p-4 pt-20 pb-24 max-w-lg mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <a href="/wardrobe" class="btn btn-ghost btn-sm btn-circle" aria-label="{{t 'lang.BACK'}}">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
    </a>
    <h1 class="text-2xl font-bold">{{t 'lang.AI_PHOTO_INTAKE_TITLE'}}</h1>
  </div>

  <form method="post" action="/wardrobe/ai-confirm" enctype="multipart/form-data" class="flex flex-col gap-4">
    <div class="form-control">
      <label class="label"><span class="label-text">{{t 'lang.PHOTO'}}</span></label>
      <input type="file" name="photo" accept="image/jpeg,image/png,image/gif,image/webp" class="file-input file-input-bordered w-full" required />
    </div>
    <button type="submit" class="btn btn-primary">{{t 'lang.AI_ANALYZE_PHOTO'}}</button>
    <a href="/wardrobe/new" class="btn btn-ghost">{{t 'lang.MANUAL_ENTRY'}}</a>
  </form>
</main>

{{>dock}}
