{{>navbar}}

<main class="p-4 pt-20 pb-24 max-w-lg mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <a href="{{#if garment}}/wardrobe/{{garment.id}}{{else}}/wardrobe{{/if}}" class="btn btn-ghost btn-sm btn-circle">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
    </a>
    <h1 class="text-2xl font-bold">
      {{#if garment}}{{t 'lang.EDIT_GARMENT'}}{{else}}{{t 'lang.NEW_GARMENT'}}{{/if}}
    </h1>
  </div>

  {{#unless garment}}
  <a href="/wardrobe/ai-intake" class="btn btn-outline w-full mb-4">{{t 'lang.AI_PHOTO_INTAKE'}}</a>
  {{/unless}}

  <form
    method="POST"
    action="{{#if garment}}/wardrobe/{{garment.id}}{{else}}/wardrobe{{/if}}"
    class="flex flex-col gap-4"
  >
    <div class="form-control">
      <label class="label"><span class="label-text">{{t 'lang.NAME'}}</span></label>
      <input
        type="text"
        name="name"
        class="input input-bordered"
        value="{{#if garment}}{{garment.name}}{{/if}}"
        placeholder="e.g. Black Linen Blazer"
      />
    </div>

    <div class="form-control">
      <label class="label"><span class="label-text">{{t 'lang.CATEGORY'}} *</span></label>
      <input
        type="text"
        name="category"
        list="category-suggestions"
        class="input input-bordered w-full"
        value="{{#if garment}}{{garment.category}}{{/if}}"
        required
        placeholder="{{t 'lang.TYPE_OR_SELECT_CATEGORY'}}"
        autocomplete="off"
      />
      <datalist id="category-suggestions">
        {{#each categories}}
        <option value="{{this.value}}"></option>
        {{/each}}
      </datalist>
    </div>

    <div class="form-control">
      <label class="label"><span class="label-text">{{t 'lang.SUBCATEGORY'}}</span></label>
      <input
        type="text"
        name="subcategory"
        class="input input-bordered"
        value="{{#if garment}}{{garment.subcategory}}{{/if}}"
        placeholder="{{t 'lang.SUBCATEGORY_PLACEHOLDER'}}"
      />
    </div>

    <div class="form-control">
      <label class="label"><span class="label-text">{{t 'lang.BRAND'}}</span></label>
      <input
        type="text"
        name="brand"
        class="input input-bordered"
        value="{{#if garment}}{{garment.brand}}{{/if}}"
        placeholder="e.g. Levi's"
      />
    </div>

    <div class="form-control">
      <label class="label"><span class="label-text">{{t 'lang.COLOR'}}</span></label>
      <select name="color" class="select select-bordered">
        <option value="">{{t 'lang.SELECT_COLOR'}}</option>
        {{#each colors}}
        <option value="{{this}}" {{#ifEquals this ../garment.color}}selected{{/ifEquals}} class="capitalize">{{this}}</option>
        {{/each}}
      </select>
    </div>

    <div class="form-control">
      <label class="label"><span class="label-text">{{t 'lang.SIZE'}}</span></label>
      <input
        type="text"
        name="size"
        class="input input-bordered"
        value="{{#if garment}}{{garment.size}}{{/if}}"
        placeholder="M, 32, One Size…"
      />
    </div>

    <div class="form-control">
      <label class="label"><span class="label-text">{{t 'lang.STATUS'}}</span></label>
      <select name="status" class="select select-bordered">
        {{#each statuses}}
        <option value="{{this}}" {{#ifEquals this ../garment.status}}selected{{/ifEquals}}>{{this}}</option>
        {{/each}}
      </select>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="form-control">
        <label class="label"><span class="label-text">{{t 'lang.SEASONS'}}</span></label>
        <input
          type="text"
          name="seasons"
          class="input input-bordered"
          value="{{#if garment}}{{garment.seasons}}{{/if}}"
          placeholder="{{t 'lang.TAG_INPUT_HINT'}}"
        />
      </div>

      <div class="form-control">
        <label class="label"><span class="label-text">{{t 'lang.STYLE_TAGS'}}</span></label>
        <input
          type="text"
          name="styleTags"
          class="input input-bordered"
          value="{{#if garment}}{{garment.styleTags}}{{/if}}"
          placeholder="{{t 'lang.TAG_INPUT_HINT'}}"
        />
      </div>

      <div class="form-control">
        <label class="label"><span class="label-text">{{t 'lang.SCENE_TAGS'}}</span></label>
        <input
          type="text"
          name="sceneTags"
          class="input input-bordered"
          value="{{#if garment}}{{garment.sceneTags}}{{/if}}"
          placeholder="{{t 'lang.TAG_INPUT_HINT'}}"
        />
      </div>

      <div class="form-control">
        <label class="label"><span class="label-text">{{t 'lang.MATERIAL'}}</span></label>
        <input
          type="text"
          name="material"
          class="input input-bordered"
          value="{{#if garment}}{{garment.material}}{{/if}}"
          placeholder="{{t 'lang.MATERIAL_PLACEHOLDER'}}"
        />
      </div>

      <div class="form-control">
        <label class="label"><span class="label-text">{{t 'lang.THICKNESS'}}</span></label>
        <input
          type="text"
          name="thickness"
          class="input input-bordered"
          value="{{#if garment}}{{garment.thickness}}{{/if}}"
          placeholder="{{t 'lang.THICKNESS_PLACEHOLDER'}}"
        />
      </div>

      <div class="form-control">
        <label class="label"><span class="label-text">{{t 'lang.FIT'}}</span></label>
        <input
          type="text"
          name="fit"
          class="input input-bordered"
          value="{{#if garment}}{{garment.fit}}{{/if}}"
          placeholder="{{t 'lang.FIT_PLACEHOLDER'}}"
        />
      </div>

      <div class="form-control">
        <label class="label"><span class="label-text">{{t 'lang.PRICE'}}</span></label>
        <input
          type="number"
          step="0.01"
          name="price"
          class="input input-bordered"
          value="{{#if garment}}{{garment.price}}{{/if}}"
          placeholder="399"
        />
      </div>

      <div class="form-control">
        <label class="label"><span class="label-text">{{t 'lang.PURCHASE_DATE'}}</span></label>
        <input
          type="date"
          name="purchaseDate"
          class="input input-bordered"
          value="{{#if garment}}{{garment.purchaseDate}}{{/if}}"
        />
      </div>
    </div>

    <div class="form-control">
      <label class="label"><span class="label-text">{{t 'lang.PURCHASE_CHANNEL'}}</span></label>
      <input
        type="text"
        name="purchaseChannel"
        class="input input-bordered"
        value="{{#if garment}}{{garment.purchaseChannel}}{{/if}}"
        placeholder="{{t 'lang.PURCHASE_CHANNEL_PLACEHOLDER'}}"
      />
    </div>

    <div class="form-control">
      <label class="label"><span class="label-text">{{t 'lang.NOTES'}}</span></label>
      <textarea
        name="notes"
        class="textarea textarea-bordered"
        rows="3"
        placeholder="Any notes about this garment…"
      >{{#if garment}}{{garment.notes}}{{/if}}</textarea>
    </div>

    <div class="flex gap-2 mt-2">
      <a href="{{#if garment}}/wardrobe/{{garment.id}}{{else}}/wardrobe{{/if}}" class="btn btn-ghost flex-1">{{t 'lang.CANCEL'}}</a>
      <button type="submit" class="btn btn-primary flex-1">{{t 'lang.SAVE'}}</button>
    </div>
  </form>
</main>

{{>dock}}
