<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="text"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-path="{{item.pagePath}}"
    bindtap="onTap"
  >
    <view class="icon icon-{{item.icon}}"></view>
    <text class="label">{{item.text}}</text>
  </view>
</view>
