.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f5efe4;
  box-sizing: border-box;
}

.photo-picker {
  height: 420rpx;
  overflow: hidden;
  border-radius: 34rpx;
  background: #ded7ca;
}

.readonly-photo {
  opacity: 0.96;
}

.edit-banner {
  margin-bottom: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #5d685f;
  font-size: 26rpx;
}

.bulk-banner {
  background: #fff8e8;
  color: #7a4b20;
}

.preview {
  width: 100%;
  height: 100%;
}

.pick-placeholder {
  display: flex;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: #686056;
  font-size: 30rpx;
}

.notice {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #fff2ec;
  color: #a23e20;
}

.ai-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
}

.ai-loading {
  color: #5d685f;
}

.ai-title {
  display: block;
  margin-bottom: 18rpx;
  color: #26362d;
  font-size: 28rpx;
  font-weight: 800;
}

.ai-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ai-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #edf4ef;
  color: #26362d;
  font-size: 24rpx;
}

.duplicate-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff8e8;
  color: #7a4b20;
}

.duplicate-panel-ack {
  background: #edf4ef;
  color: #26362d;
}

.duplicate-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
}

.duplicate-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.duplicate-action {
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #26362d;
  color: #fff8e8;
  font-size: 26rpx;
}

.form {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.86);
}

.field {
  display: block;
  margin-bottom: 24rpx;
  color: #26362d;
  font-size: 26rpx;
  font-weight: 700;
}

input,
textarea,
.picker-value {
  width: 100%;
  margin-top: 10rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #ded7ca;
  color: #26362d;
  font-size: 30rpx;
  font-weight: 400;
}

textarea {
  min-height: 130rpx;
}

.picker-value {
  box-sizing: border-box;
}

.submit {
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #26362d;
  color: #fff8e8;
}

.skip {
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #7a4b20;
}

.compare-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  background: rgba(18, 24, 21, 0.46);
}

.compare-sheet {
  width: 100%;
  max-height: 86vh;
  padding: 28rpx 24rpx 32rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #fff8e8;
  box-sizing: border-box;
}

.compare-header {
  padding: 8rpx 8rpx 0;
}

.compare-title {
  display: block;
  color: #26362d;
  font-size: 32rpx;
  font-weight: 800;
}

.compare-copy {
  display: block;
  margin-top: 12rpx;
  color: #5d685f;
  font-size: 24rpx;
  line-height: 1.7;
}

.compare-scroll {
  height: 58vh;
  margin-top: 22rpx;
}

.compare-section {
  margin-bottom: 24rpx;
}

.compare-section-title {
  display: block;
  margin-bottom: 14rpx;
  color: #26362d;
  font-size: 26rpx;
  font-weight: 800;
}

.compare-card {
  display: flex;
  gap: 18rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
}

.compare-card-current {
  border: 2rpx solid #d8eadf;
}

.compare-photo {
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #ded7ca;
}

.compare-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #686056;
  font-size: 24rpx;
}

.compare-body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.compare-name {
  color: #26362d;
  font-size: 28rpx;
  font-weight: 800;
}

.compare-meta,
.compare-detail,
.compare-note {
  color: #5d685f;
  font-size: 24rpx;
  line-height: 1.6;
}

.compare-note {
  color: #7a4b20;
}

.compare-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.compare-primary,
.compare-secondary {
  flex: 1;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.compare-primary {
  background: #26362d;
  color: #fff8e8;
}

.compare-secondary {
  background: rgba(255, 255, 255, 0.92);
  color: #5d685f;
}
