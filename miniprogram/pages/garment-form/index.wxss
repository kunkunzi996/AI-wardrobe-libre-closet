.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f5efe4;
  box-sizing: border-box;
}

.photo-picker {
  height: 420rpx;
  overflow: hidden;
  border-radius: 34rpx;
  background: #ded7ca;
}

.preview {
  width: 100%;
  height: 100%;
}

.pick-placeholder {
  display: flex;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: #686056;
  font-size: 30rpx;
}

.notice {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #fff2ec;
  color: #a23e20;
}

.ai-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
}

.ai-loading {
  color: #5d685f;
}

.ai-title {
  display: block;
  margin-bottom: 18rpx;
  color: #26362d;
  font-size: 28rpx;
  font-weight: 800;
}

.ai-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ai-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #edf4ef;
  color: #26362d;
  font-size: 24rpx;
}

.form {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.86);
}

.field {
  display: block;
  margin-bottom: 24rpx;
  color: #26362d;
  font-size: 26rpx;
  font-weight: 700;
}

input,
textarea,
.picker-value {
  width: 100%;
  margin-top: 10rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #ded7ca;
  color: #26362d;
  font-size: 30rpx;
  font-weight: 400;
}

textarea {
  min-height: 130rpx;
}

.picker-value {
  box-sizing: border-box;
}

.submit {
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #26362d;
  color: #fff8e8;
}
