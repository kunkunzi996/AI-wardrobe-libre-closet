.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 56rpx;
  background: #f7f6fb;
  box-sizing: border-box;
}

/* ---------- 照片选择 ---------- */
.photo-picker {
  height: 360rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: #e1d9f6;
}

.readonly-photo {
  opacity: 0.96;
}

.edit-banner {
  margin-bottom: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #fff;
  color: #6b6580;
  font-size: 26rpx;
  box-shadow: 0 4rpx 14rpx rgba(34, 26, 58, 0.05);
}

.bulk-banner {
  background: #f3e08a;
  color: #6b5310;
  box-shadow: none;
}

.preview {
  width: 100%;
  height: 100%;
}

.pick-placeholder {
  display: flex;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: #7c72a8;
  font-size: 30rpx;
}

/* ---------- 通用提示 ---------- */
.notice {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fbe6f0;
  color: #b23a78;
}

/* ---------- AI 识别建议（Notion 醒目黄） ---------- */
.ai-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f3e08a;
}

.ai-loading {
  color: #6b5310;
}

.ai-title {
  display: block;
  margin-bottom: 16rpx;
  color: #6b5310;
  font-size: 28rpx;
  font-weight: 700;
}

.ai-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ai-taxonomy {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ai-tag-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.ai-tag-label {
  min-width: 112rpx;
  padding-top: 8rpx;
  color: #6b5310;
  font-size: 22rpx;
  font-weight: 700;
}

.ai-tag {
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #6b5310;
  font-size: 24rpx;
  font-weight: 600;
}

/* ---------- 相似衣物提醒 ---------- */
.duplicate-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f3e08a;
  color: #6b5310;
}

.duplicate-panel-ack {
  background: #e4f2e9;
  color: #2c8559;
}

.duplicate-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.duplicate-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.duplicate-action {
  margin-top: 18rpx;
  border-radius: 16rpx;
  background: #6f5ae0;
  color: #fff;
  font-size: 26rpx;
}

.duplicate-action::after {
  border: none;
}

/* ---------- 表单 ---------- */
.form {
  margin-top: 24rpx;
  padding: 28rpx 24rpx 8rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.field {
  display: block;
  margin-bottom: 24rpx;
  color: #6b6580;
  font-size: 24rpx;
  font-weight: 600;
}

input,
textarea {
  width: 100%;
  margin-top: 12rpx;
  border-radius: 14rpx;
  background: #f7f6fb;
  color: #221c3a;
  font-size: 28rpx;
  font-weight: 400;
  box-sizing: border-box;
}

/* 单行输入框：固定高度，文字完整居中，避免被裁 */
input {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

/* 多行备注：可换行，给足上下空间 */
textarea {
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  line-height: 1.5;
}

.taxonomy-fields {
  margin-bottom: 4rpx;
}

.taxonomy-field {
  margin-bottom: 22rpx;
}

.taxonomy-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: #f7f6fb;
  box-sizing: border-box;
}

.taxonomy-picker-text {
  flex: 1;
  color: #221c3a;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
}

.taxonomy-picker-placeholder {
  color: #9a94ac;
}

.taxonomy-picker-arrow {
  flex-shrink: 0;
  color: #9a94ac;
  font-size: 24rpx;
  transition: transform 0.2s ease;
}

.taxonomy-picker-arrow-open {
  transform: rotate(180deg);
}

.taxonomy-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.taxonomy-chip {
  width: auto;
  min-width: 104rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f7f6fb;
  color: #6b6580;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 64rpx;
}

.taxonomy-chip::after {
  border: 2rpx solid #e4e1ee;
  border-radius: 12rpx;
}

.taxonomy-chip-selected {
  background: #6f5ae0;
  color: #fff;
}

.taxonomy-chip-selected::after {
  border-color: #6f5ae0;
}

.taxonomy-error {
  margin-bottom: 24rpx;
  color: #b23a78;
  font-size: 24rpx;
}

.submit {
  margin-top: 32rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: #6f5ae0;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
  box-shadow: 0 16rpx 32rpx -10rpx rgba(111, 90, 224, 0.6);
}

.submit::after {
  border: none;
}

.skip {
  margin-top: 18rpx;
  border-radius: 20rpx;
  background: #fff;
  color: #6b6580;
  font-size: 28rpx;
}

.skip::after {
  border: 2rpx solid #e4e1ee;
}

/* ---------- 相似衣物对比弹窗 ---------- */
.compare-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  background: rgba(34, 26, 58, 0.46);
}

.compare-sheet {
  width: 100%;
  max-height: 86vh;
  padding: 28rpx 24rpx 32rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #f7f6fb;
  box-sizing: border-box;
}

.compare-header {
  padding: 8rpx 8rpx 0;
}

.compare-title {
  display: block;
  color: #221c3a;
  font-size: 32rpx;
  font-weight: 700;
}

.compare-copy {
  display: block;
  margin-top: 12rpx;
  color: #6b6580;
  font-size: 24rpx;
  line-height: 1.7;
}

.compare-scroll {
  height: 58vh;
  margin-top: 22rpx;
}

.compare-section {
  margin-bottom: 24rpx;
}

.compare-section-title {
  display: block;
  margin-bottom: 14rpx;
  color: #221c3a;
  font-size: 26rpx;
  font-weight: 700;
}

.compare-card {
  display: flex;
  gap: 18rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff;
}

.compare-card-current {
  border: 2rpx solid #d8d2f0;
}

.compare-photo {
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: #e1d9f6;
}

.compare-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7c72a8;
  font-size: 24rpx;
}

.compare-body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.compare-name {
  color: #221c3a;
  font-size: 28rpx;
  font-weight: 700;
}

.compare-meta,
.compare-detail,
.compare-note {
  color: #6b6580;
  font-size: 24rpx;
  line-height: 1.6;
}

.compare-note {
  color: #b5651f;
}

.compare-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.compare-primary,
.compare-secondary {
  flex: 1;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.compare-primary {
  background: #6f5ae0;
  color: #fff;
}

.compare-primary::after {
  border: none;
}

.compare-secondary {
  background: #fff;
  color: #6b6580;
}

.compare-secondary::after {
  border: 2rpx solid #e4e1ee;
}
