<view class="page">
  <view wx:if="{{isEdit}}" class="edit-banner">正在编辑衣物信息，第一版暂不支持更换图片。</view>
  <view wx:if="{{isBulkImport}}" class="edit-banner bulk-banner">
    批量导入第 {{bulkIndex + 1}} / {{bulkTotal}} 张，请确认或修改后保存。
  </view>

  <view class="photo-picker {{isEdit ? 'readonly-photo' : ''}}" bindtap="choosePhoto">
    <image wx:if="{{photoPath}}" src="{{photoPath}}" mode="aspectFill" class="preview" />
    <view wx:else class="pick-placeholder">{{isEdit ? '暂无图片' : '选择衣物图片'}}</view>
  </view>

  <view wx:if="{{error}}" class="notice">{{error}}</view>
  <view wx:if="{{recognizing}}" class="ai-panel ai-loading">AI正在识别衣服...</view>
  <view wx:elif="{{aiError}}" class="notice">{{aiError}}</view>
  <view wx:elif="{{aiDraft}}" class="ai-panel">
    <text class="ai-title">✨ AI 识别建议</text>
    <view class="ai-taxonomy">
      <view wx:for="{{aiTaxonomyGroups}}" wx:key="key" class="ai-tag-row">
        <text class="ai-tag-label">{{item.label}}</text>
        <view class="ai-tags">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="ai-tag">{{tag}}</text>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{!isEdit && duplicateCandidates.length}}" class="duplicate-panel {{duplicateWarningAcknowledged ? 'duplicate-panel-ack' : ''}}">
    <text class="duplicate-title">{{duplicateWarningAcknowledged ? '已确认可继续录入' : '发现类似衣服'}}</text>
    <text wx:if="{{duplicateWarningAcknowledged}}" class="duplicate-copy">
      你已经确认这不是同一件衣服；如果想再比对一次，可以重新打开。
    </text>
    <text wx:else class="duplicate-copy">
      系统找到了 {{duplicateCandidates.length}} 件相似衣物，保存前建议先看一下。
    </text>
    <button class="duplicate-action" bindtap="onViewDuplicateCandidates">查看类似衣服</button>
  </view>

  <view class="form">
    <label class="field">
      <text>名称</text>
      <input value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="例如：黑色外套" />
    </label>
    <view wx:for="{{fieldGroups}}" wx:key="key" wx:for-item="fieldGroup" class="field taxonomy-field">
      <text>{{fieldGroup.label}}{{fieldGroup.required ? ' *' : ''}}</text>
      <view
        class="taxonomy-picker"
        data-group="{{fieldGroup.key}}"
        bindtap="toggleFieldGroup"
      >
        <text wx:if="{{fieldGroup.selectedText}}" class="taxonomy-picker-text">{{fieldGroup.selectedText}}</text>
        <text wx:else class="taxonomy-picker-text taxonomy-picker-placeholder">点击选择</text>
        <text class="taxonomy-picker-arrow {{fieldGroup.expanded ? 'taxonomy-picker-arrow-open' : ''}}">▾</text>
      </view>
      <view wx:if="{{fieldGroup.expanded}}" class="taxonomy-options">
        <button
          wx:for="{{fieldGroup.options}}"
          wx:key="value"
          wx:for-item="fieldOption"
          class="taxonomy-chip {{fieldOption.selected ? 'taxonomy-chip-selected' : ''}}"
          data-group="{{fieldGroup.key}}"
          data-value="{{fieldOption.value}}"
          bindtap="toggleFieldOption"
        >{{fieldOption.label}}</button>
      </view>
    </view>
    <view wx:if="{{editableTaxonomyGroups.length}}" class="taxonomy-fields">
      <view wx:for="{{editableTaxonomyGroups}}" wx:key="key" wx:for-item="tagGroup" class="field taxonomy-field">
        <text>{{tagGroup.label}}</text>
        <view
          class="taxonomy-picker"
          data-group="{{tagGroup.key}}"
          bindtap="toggleTaxonomyGroup"
        >
          <text wx:if="{{tagGroup.selectedText}}" class="taxonomy-picker-text">{{tagGroup.selectedText}}</text>
          <text wx:else class="taxonomy-picker-text taxonomy-picker-placeholder">点击选择</text>
          <text class="taxonomy-picker-arrow {{tagGroup.expanded ? 'taxonomy-picker-arrow-open' : ''}}">▾</text>
        </view>
        <view wx:if="{{tagGroup.expanded}}" class="taxonomy-options">
          <button
            wx:for="{{tagGroup.options}}"
            wx:key="label"
            wx:for-item="tagOption"
            class="taxonomy-chip {{tagOption.selected ? 'taxonomy-chip-selected' : ''}}"
            data-group="{{tagGroup.key}}"
            data-tag="{{tagOption.label}}"
            bindtap="toggleTaxonomyTag"
          >{{tagOption.label}}</button>
        </view>
      </view>
    </view>
    <view wx:elif="{{taxonomyError}}" class="taxonomy-error">{{taxonomyError}}</view>
    <label class="field">
      <text>品牌</text>
      <input value="{{form.brand}}" data-field="brand" bindinput="onInput" placeholder="可不填" />
    </label>
    <label class="field">
      <text>尺码</text>
      <input value="{{form.size}}" data-field="size" bindinput="onInput" placeholder="S / M / L" />
    </label>
    <label class="field">
      <text>备注</text>
      <textarea value="{{form.notes}}" data-field="notes" bindinput="onInput" placeholder="可不填" />
    </label>
  </view>

  <button class="submit" loading="{{submitting}}" bindtap="submitGarment">
    {{isEdit ? '保存修改' : '保存衣物'}}
  </button>
  <button wx:if="{{isBulkImport}}" class="skip" disabled="{{submitting}}" bindtap="skipBulkImportItem">
    跳过这张
  </button>

  <view wx:if="{{duplicateCompareVisible}}" class="compare-mask" catchtouchmove="noop">
    <view class="compare-sheet">
      <view class="compare-header">
        <text class="compare-title">查看类似衣服</text>
        <text class="compare-copy">
          把本次新增和库存里识别成相似的衣服放在一起看，更容易判断是不是同一件。
        </text>
      </view>

      <scroll-view scroll-y class="compare-scroll">
        <view class="compare-section">
          <text class="compare-section-title">本次新增</text>
          <view class="compare-card compare-card-current">
            <image
              wx:if="{{duplicateCurrentItem.photoUrl}}"
              src="{{duplicateCurrentItem.photoUrl}}"
              mode="aspectFill"
              class="compare-photo"
            />
            <view wx:else class="compare-photo compare-placeholder">暂无图片</view>
            <view class="compare-body">
              <text class="compare-name">{{duplicateCurrentItem.name}}</text>
              <text wx:if="{{duplicateCurrentItem.subcategory}}" class="compare-meta">
                {{duplicateCurrentItem.subcategory}}
              </text>
              <text class="compare-meta">
                {{duplicateCurrentItem.categoryLabel}}{{duplicateCurrentItem.colorLabel ? ' · ' + duplicateCurrentItem.colorLabel : ''}}
              </text>
              <text wx:if="{{duplicateCurrentItem.detailText}}" class="compare-detail">
                {{duplicateCurrentItem.detailText}}
              </text>
              <text wx:if="{{duplicateCurrentItem.notes}}" class="compare-note">
                {{duplicateCurrentItem.notes}}
              </text>
            </view>
          </view>
        </view>

        <view class="compare-section">
          <text class="compare-section-title">库存里识别成相似的衣服</text>
          <view wx:for="{{duplicateCandidates}}" wx:key="id" wx:for-item="candidate" class="compare-card">
            <image
              wx:if="{{candidate.photoUrl}}"
              src="{{candidate.photoUrl}}"
              mode="aspectFill"
              class="compare-photo"
            />
            <view wx:else class="compare-photo compare-placeholder">暂无图片</view>
            <view class="compare-body">
              <text class="compare-name">
                {{candidate.name || candidate.subcategory || candidate.categoryLabel || '相似衣物'}}
              </text>
              <text wx:if="{{candidate.subcategory}}" class="compare-meta">
                {{candidate.subcategory}}
              </text>
              <text class="compare-meta">
                {{candidate.categoryLabel}}{{candidate.colorLabel ? ' · ' + candidate.colorLabel : ''}}
              </text>
              <text wx:if="{{candidate.matchReason}}" class="compare-detail">
                相似原因：{{candidate.matchReason}}
              </text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="compare-actions">
        <button class="compare-secondary" bindtap="closeDuplicateCompare">返回修改</button>
        <button class="compare-primary" bindtap="confirmDuplicateDifference">
          {{duplicateCompareSubmitOnConfirm ? '确认不是同一件，继续录入' : '确认不是同一件'}}
        </button>
      </view>
    </view>
  </view>
</view>
