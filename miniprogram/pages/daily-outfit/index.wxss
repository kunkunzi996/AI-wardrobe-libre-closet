.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 160rpx;
  background: #eceaf0;
  box-sizing: border-box;
}

/* ---------- 顶部标题 ---------- */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 4rpx 0;
}

.eyebrow {
  display: block;
  margin-bottom: 6rpx;
  color: #9a94ac;
  font-size: 24rpx;
}

.title {
  display: block;
  color: #221c3a;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.refresh {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #5a47c9;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(34, 26, 58, 0.05);
}

/* ---------- 提示 / 空态 ---------- */
.notice,
.empty,
.entry,
.loading {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.error {
  background: #fbe6f0;
  color: #b23a78;
  box-shadow: none;
}

.retry,
.primary {
  margin-top: 18rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #6f5ae0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.retry::after,
.primary::after {
  border: none;
}

.loading {
  color: #6b6580;
  text-align: center;
}

.empty-title,
.empty-text,
.entry-title,
.entry-notes {
  display: block;
}

.empty-title,
.entry-title {
  color: #221c3a;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-text,
.entry-notes {
  margin-top: 12rpx;
  color: #6b6580;
  font-size: 26rpx;
  line-height: 1.6;
}

/* ---------- 衣物网格 ---------- */
.garment-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.garment {
  padding: 16rpx;
  border-radius: 24rpx;
  background: #e1d9f6;
  box-sizing: border-box;
}

.photo {
  width: 100%;
  height: 220rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.55);
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(34, 26, 58, 0.4);
  font-size: 24rpx;
}

.garment-name,
.meta {
  display: block;
  padding: 0 6rpx;
}

.garment-name {
  margin-top: 14rpx;
  color: #2e2742;
  font-size: 28rpx;
  font-weight: 600;
}

.meta {
  margin-top: 6rpx;
  color: rgba(46, 39, 66, 0.55);
  font-size: 24rpx;
}
