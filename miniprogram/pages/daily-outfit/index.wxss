.page {
  min-height: 100vh;
  padding: 32rpx;
  background: linear-gradient(180deg, #eef6f3 0%, #f7f2e8 100%);
  box-sizing: border-box;
}

.toolbar {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.secondary {
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #26362d;
  font-size: 28rpx;
}

.header,
.entry,
.notice,
.empty {
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #7a7469;
  font-size: 24rpx;
}

.title {
  display: block;
  color: #26362d;
  font-size: 44rpx;
  font-weight: 800;
}

.notice,
.empty,
.entry,
.loading {
  margin-top: 24rpx;
}

.error {
  background: #fff2ec;
  color: #a23e20;
}

.retry,
.primary {
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #26362d;
  color: #fff8e8;
}

.loading {
  color: #5d685f;
  text-align: center;
}

.empty-title,
.empty-text,
.entry-title,
.entry-notes {
  display: block;
}

.empty-title,
.entry-title {
  color: #26362d;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-text,
.entry-notes {
  margin-top: 12rpx;
  color: #5d685f;
  line-height: 1.6;
}

.garment-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.garment {
  overflow: hidden;
  border-radius: 24rpx;
  background: #fff;
}

.photo {
  width: 100%;
  height: 220rpx;
  background: #ded7ca;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8174;
}

.garment-name,
.meta {
  display: block;
  padding: 0 18rpx;
}

.garment-name {
  margin-top: 16rpx;
  color: #26362d;
  font-size: 28rpx;
  font-weight: 700;
}

.meta {
  margin: 8rpx 0 18rpx;
  color: #7a7469;
  font-size: 24rpx;
}
