<view class="page">
  <view class="header">
    <view class="header-text">
      <text class="eyebrow">{{date}}</text>
      <text class="title">今日穿搭</text>
    </view>
    <view class="header-actions">
      <view class="refresh" bindtap="retryLoad">重新加载</view>
      <view class="add" bindtap="goToAddOutfit">+ 添加</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="notice error">
    <text>{{error}}</text>
    <button class="retry" loading="{{loading}}" bindtap="retryLoad">重试</button>
  </view>
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{!error && items.length === 0}}" class="empty">
    <text class="empty-title">今天还没有保存穿搭</text>
    <text class="empty-text">拍一张今天的全身照，先把喜欢的搭配存下来。</text>
    <button class="primary" bindtap="goToAddOutfit">添加穿搭</button>
    <button class="secondary" bindtap="goToOutfit">去生成搭配</button>
  </view>

  <view wx:else class="list">
    <view wx:for="{{items}}" wx:key="id" class="entry">
      <text class="entry-title">{{item.outfit.name}}</text>
      <text wx:if="{{item.notes}}" class="entry-notes">{{item.notes}}</text>
      <image
        wx:if="{{item.outfit.photoUrl}}"
        class="outfit-photo"
        src="{{item.outfit.photoUrl}}"
        mode="widthFix"
      />
      <view class="garment-grid">
        <view
          wx:for="{{item.outfit.garments}}"
          wx:for-item="garment"
          wx:key="id"
          class="garment"
          data-id="{{garment.id}}"
          bindtap="goToGarment"
        >
          <image wx:if="{{garment.photoUrl}}" class="photo" src="{{garment.photoUrl}}" mode="aspectFill" />
          <view wx:else class="photo placeholder">暂无图片</view>
          <text class="garment-name">{{garment.name || garment.categoryLabel}}</text>
          <text class="meta">{{garment.categoryLabel}} · {{garment.colorLabel}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
