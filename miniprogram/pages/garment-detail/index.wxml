<view class="page">
  <view class="actions">
    <button class="secondary" bindtap="goBackToWardrobe">返回衣橱</button>
    <button class="secondary" loading="{{loading}}" bindtap="reloadGarment">重新加载</button>
  </view>
  <view wx:if="{{error}}" class="notice">{{error}}</view>
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:if="{{garment}}" class="detail">
    <view class="photo-card">
      <image wx:if="{{garment.photoUrl}}" class="photo" src="{{garment.photoUrl}}" mode="aspectFill" />
      <view wx:else class="photo photo-placeholder">暂无图片</view>
      <button wx:if="{{garment.originalPhotoUrl}}" class="secondary" loading="{{originalLoading}}" disabled="{{originalLoading}}" bindtap="previewOriginalPhoto">查看上传原图</button>
    </view>

    <view wx:if="{{normalization}}" class="normalization-card">
      <text class="normalization-title">AI 衣物整理</text>
      <text wx:if="{{normalization.message}}" class="normalization-message">{{normalization.message}}</text>
      <text wx:if="{{normalizationError}}" class="normalization-error">{{normalizationError}}</text>
      <button wx:if="{{normalization.canStart}}" class="secondary" loading="{{normalizationStarting}}" disabled="{{normalizationStarting}}" bindtap="startImageNormalization">AI 整理（生成一张）</button>
      <button wx:if="{{normalization.status === 'queued' || normalization.status === 'processing' || normalization.status === 'uncertain' || normalizationError}}" class="secondary" bindtap="refreshNormalizationStatus">查看处理状态</button>
      <view wx:if="{{normalizationPreviewVisible && normalization.candidatePhotoUrl}}" class="normalization-comparison">
        <view class="normalization-picture"><text>当前展示</text><image src="{{garment.photoUrl}}" mode="aspectFit" /></view>
        <view class="normalization-picture"><text>{{normalization.adopted ? '整理图 · 已采用' : '整理候选 · 尚未采用'}}</text><image src="{{normalization.candidatePhotoUrl}}" mode="aspectFit" /></view>
      </view>
      <button wx:if="{{normalizationPreviewVisible && normalization.canAdopt}}" class="secondary" disabled="{{normalizationAdopting}}" loading="{{normalizationAdopting}}" bindtap="adoptImageNormalization">采用这张整理图</button>
      <button wx:if="{{normalizationPreviewVisible}}" class="secondary" disabled="{{normalizationAdopting}}" bindtap="dismissNormalizationPreview">{{normalization.adopted ? '收起预览' : '暂不采用'}}</button>
    </view>

    <view class="info">
      <text class="name">{{garment.name || garment.categoryLabel}}</text>
      <text class="meta">{{garment.categoryLabel}} · {{garment.colorLabel}}</text>

      <view wx:if="{{garment.taxonomyTagList.length || garment.styleTags.length || garment.sceneTags.length}}" class="tag-panel">
        <block wx:if="{{garment.taxonomyTagList.length}}">
          <text wx:for="{{garment.taxonomyTagList}}" wx:key="*this" class="tag tag-lavender">{{item}}</text>
        </block>
        <block wx:else>
          <text wx:for="{{garment.styleTags}}" wx:key="*this" class="tag tag-lavender">{{item}}</text>
          <text wx:for="{{garment.sceneTags}}" wx:key="*this" class="tag tag-peach">{{item}}</text>
        </block>
      </view>

      <view class="stat-grid">
        <view class="stat-card stat-peach">
          <text class="stat-label">季节</text>
          <text class="stat-value">{{garment.seasonDisplay || '-'}}</text>
        </view>
        <view class="stat-card stat-mint">
          <text class="stat-label">材质</text>
          <text class="stat-value">{{garment.material || '-'}}</text>
        </view>
        <view class="stat-card stat-sky">
          <text class="stat-label">品牌</text>
          <text class="stat-value">{{garment.brand || '-'}}</text>
        </view>
        <view class="stat-card stat-rose">
          <text class="stat-label">尺码</text>
          <text class="stat-value">{{garment.size || '-'}}</text>
        </view>
        <view wx:if="{{garment.subcategory}}" class="stat-card stat-lavender">
          <text class="stat-label">细分</text>
          <text class="stat-value">{{garment.subcategory}}</text>
        </view>
        <view wx:if="{{garment.thickness}}" class="stat-card stat-peach">
          <text class="stat-label">厚薄</text>
          <text class="stat-value">{{garment.thickness}}</text>
        </view>
      </view>

      <view class="notes">{{garment.notes || '暂无备注'}}</view>
    </view>

    <button class="recommend" bindtap="goToOutfitRecommendation">围绕这件搭配</button>
    <view class="bottom-row">
      <button class="edit" bindtap="goToEdit">编辑</button>
      <button class="danger" bindtap="deleteGarment">删除</button>
    </view>
  </view>
</view>
