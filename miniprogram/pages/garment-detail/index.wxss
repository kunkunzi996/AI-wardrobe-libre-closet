.page {
  min-height: 100vh;
  padding: 32rpx;
  background: linear-gradient(180deg, #edf4ef 0%, #f7f2e8 100%);
  box-sizing: border-box;
}

.notice,
.loading {
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.86);
}

.actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.secondary {
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #26362d;
  font-size: 28rpx;
}

.photo {
  width: 100%;
  height: 620rpx;
  border-radius: 36rpx;
  background: #ded7ca;
}

.info {
  margin-top: 28rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
}

.name {
  display: block;
  margin-bottom: 24rpx;
  color: #26362d;
  font-size: 42rpx;
  font-weight: 800;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #e7dfd3;
  color: #5d685f;
}

.tag-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e7dfd3;
}

.tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #edf4ef;
  color: #26362d;
  font-size: 24rpx;
}

.notes {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f7f2e8;
  color: #5d685f;
  line-height: 1.6;
}

.edit,
.danger {
  margin-top: 32rpx;
  border-radius: 999rpx;
}

.edit {
  background: #26362d;
  color: #fff8e8;
}

.danger {
  margin-top: 18rpx;
  background: #d96c3f;
  color: #fff;
}
