.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 56rpx;
  background: #f7f6fb;
  box-sizing: border-box;
}

.notice,
.loading {
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.notice {
  background: #f9d6e6;
  color: #b23a78;
  box-shadow: none;
}

.actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.secondary {
  height: 76rpx;
  border-radius: 18rpx;
  background: #fff;
  color: #5a47c9;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 76rpx;
  box-shadow: 0 4rpx 14rpx rgba(34, 26, 58, 0.05);
}

.secondary::after {
  border: none;
}

/* ---------- 照片 ---------- */
.photo-card {
  padding: 24rpx;
  border-radius: 36rpx;
  background: #e1d9f6;
}

.photo {
  width: 100%;
  height: 560rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.55);
}

.photo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7c72a8;
  font-size: 28rpx;
}

/* ---------- 信息卡片 ---------- */
.info {
  margin-top: 28rpx;
  padding: 32rpx 30rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.name {
  display: block;
  color: #221c3a;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
}

.meta {
  display: block;
  margin-top: 8rpx;
  color: #9a94ac;
  font-size: 26rpx;
}

.tag-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.tag {
  padding: 8rpx 22rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.tag-lavender {
  background: #e1d9f6;
  color: #5a47c9;
}

.tag-peach {
  background: #fbe1c9;
  color: #b5651f;
}

/* ---------- 2×2 属性格 ---------- */
.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 28rpx;
}

.stat-card {
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
}

.stat-label {
  display: block;
  font-size: 22rpx;
}

.stat-value {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.stat-peach {
  background: #fbe1c9;
}
.stat-peach .stat-label {
  color: #b58a5f;
}
.stat-peach .stat-value {
  color: #3a2a1e;
}

.stat-mint {
  background: #d4eedd;
}
.stat-mint .stat-label {
  color: #5f9678;
}
.stat-mint .stat-value {
  color: #1f3a2a;
}

.stat-sky {
  background: #d9e7fb;
}
.stat-sky .stat-label {
  color: #5f77a6;
}
.stat-sky .stat-value {
  color: #1e2a3a;
}

.stat-rose {
  background: #f9d6e6;
}
.stat-rose .stat-label {
  color: #b23a78;
}
.stat-rose .stat-value {
  color: #3a1e2c;
}

.stat-lavender {
  background: #e1d9f6;
}
.stat-lavender .stat-label {
  color: #7c72a8;
}
.stat-lavender .stat-value {
  color: #2e2742;
}

.notes {
  margin-top: 26rpx;
  color: #6b6580;
  font-size: 26rpx;
  line-height: 1.6;
}

/* ---------- 底部按钮 ---------- */
.recommend {
  margin-top: 32rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: #6f5ae0;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
  box-shadow: 0 16rpx 32rpx -10rpx rgba(111, 90, 224, 0.6);
}

.recommend::after {
  border: none;
}

.bottom-row {
  display: flex;
  gap: 18rpx;
  margin-top: 20rpx;
}

.edit,
.danger {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.edit {
  background: #fff;
  color: #221c3a;
}

.edit::after {
  border: 2rpx solid #e4e1ee;
}

.danger {
  background: #fff;
  color: #c0392b;
}

.danger::after {
  border: none;
}
