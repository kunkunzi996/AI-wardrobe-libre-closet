<view class="page">
  <view class="head">
    <text class="page-title">AI 搭配</text>
    <text class="page-sub">说一句话，让 AI 从你衣橱里挑一套。</text>
  </view>

  <view class="panel">
    <view class="weather-card">
      <view class="weather-head">
        <text class="title">天气依据</text>
        <text
          wx:if="{{weatherPreference.mode === 'manual'}}"
          class="weather-city"
          >手动城市：{{weatherPreference.city || '未设置'}}</text
        >
        <text wx:else class="weather-city">自动定位</text>
      </view>
      <view class="weather-modes">
        <button
          class="weather-mode {{weatherPreference.mode === 'auto' ? 'active' : ''}}"
          data-mode="auto"
          bindtap="switchWeatherMode"
        >
          自动定位
        </button>
        <button
          class="weather-mode {{weatherPreference.mode === 'manual' ? 'active' : ''}}"
          data-mode="manual"
          bindtap="switchWeatherMode"
        >
          手动城市
        </button>
      </view>
      <view wx:if="{{weather.status === 'available'}}" class="weather-basis">
        <text>{{weather.city}} · 当前温度 {{weather.currentC}}℃</text>
        <text class="weather-hourly-title">未来八小时</text>
        <view class="weather-hourly">
          <view
            wx:for="{{weather.hourly}}"
            wx:key="timestamp"
            class="weather-hour"
          >
            <text>{{item.timeLabel}}</text>
            <text>{{item.temperatureC}}℃</text>
          </view>
        </view>
      </view>
      <view wx:else class="weather-unavailable"
        >{{weather.reason || '本次未使用实时温度'}}</view
      >
    </view>
    <text class="title">想穿去哪</text>
    <textarea
      class="prompt"
      value="{{requestText}}"
      bindinput="onInput"
      placeholder="例如：明天上班穿什么 / 周末约会轻松一点"
    />
    <button class="primary" loading="{{loading}}" bindtap="generateOutfit">
      生成搭配
    </button>
  </view>

  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <view wx:elif="{{message}}" class="notice">{{message}}</view>

  <view wx:if="{{recommendations.length === 0 && !loading}}" class="empty">
    <text>输入需求后，让 AI 从你的衣橱里挑一套。</text>
  </view>

  <view wx:for="{{recommendations}}" wx:key="title" class="plan">
    <text class="plan-title">{{item.title}}</text>
    <text class="reason">{{item.reason}}</text>
    <view wx:if="{{item.cautions.length}}" class="cautions">
      <text wx:for="{{item.cautions}}" wx:key="*this">· {{item}}</text>
    </view>
    <view class="garment-grid">
      <view
        wx:for="{{item.garments}}"
        wx:for-item="garment"
        wx:key="id"
        class="garment"
        data-id="{{garment.id}}"
        bindtap="goToGarment"
      >
        <image
          wx:if="{{garment.photoUrl}}"
          class="photo"
          src="{{garment.photoUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="photo placeholder">暂无图片</view>
        <text class="garment-name"
          >{{garment.name || garment.categoryLabel}}</text
        >
        <text class="meta"
          >{{garment.categoryLabel}} · {{garment.colorLabel}}</text
        >
        <text
          wx:if="{{garment.statusLabel && garment.statusLabel !== '可穿'}}"
          class="status-label"
          >状态：{{garment.statusLabel}}</text
        >
      </view>
    </view>
    <button
      class="save"
      loading="{{savingIndex === index}}"
      data-index="{{index}}"
      bindtap="saveDailyOutfit"
    >
      {{savedIndex === index ? '已保存到今日穿搭' : '保存为今日穿搭'}}
    </button>

    <view class="feedback">
      <text class="feedback-title">这套搭配怎么样？</text>
      <view class="feedback-options">
        <view
          class="feedback-option {{item.feedbackRating === 'good' ? 'active' : ''}}"
          data-index="{{index}}"
          data-rating="good"
          bindtap="onFeedbackRating"
          >搭配得不错</view
        >
        <view
          class="feedback-option {{item.feedbackRating === 'soso' ? 'active' : ''}}"
          data-index="{{index}}"
          data-rating="soso"
          bindtap="onFeedbackRating"
          >一般</view
        >
        <view
          class="feedback-option {{item.feedbackRating === 'bad' ? 'active' : ''}}"
          data-index="{{index}}"
          data-rating="bad"
          bindtap="onFeedbackRating"
          >不喜欢</view
        >
      </view>
      <block wx:if="{{!item.feedbackSubmitted}}">
        <textarea
          class="feedback-input"
          value="{{item.feedbackComment}}"
          data-index="{{index}}"
          bindinput="onFeedbackInput"
          maxlength="500"
          placeholder="说说理由（选填），帮 AI 搭得更好"
        />
        <button
          class="feedback-submit"
          loading="{{item.feedbackSubmitting}}"
          data-index="{{index}}"
          bindtap="submitFeedback"
        >
          提交反馈
        </button>
      </block>
      <view wx:else class="feedback-done">已收到你的反馈，谢谢！</view>
    </view>
  </view>
</view>
