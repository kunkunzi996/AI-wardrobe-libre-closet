.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 160rpx;
  background: #eceaf0;
  box-sizing: border-box;
}

/* ---------- 顶部标题 ---------- */
.head {
  padding: 12rpx 4rpx 0;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #221c3a;
  letter-spacing: -1rpx;
}

.page-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9a94ac;
}

/* ---------- 输入面板 ---------- */
.panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.title {
  display: block;
  margin-bottom: 16rpx;
  color: #221c3a;
  font-size: 30rpx;
  font-weight: 700;
}

.prompt {
  width: 100%;
  min-height: 160rpx;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  background: #f7f6fb;
  color: #221c3a;
  font-size: 28rpx;
  box-sizing: border-box;
}

.primary {
  margin-top: 22rpx;
  height: 92rpx;
  border-radius: 20rpx;
  background: #6f5ae0;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
  box-shadow: 0 16rpx 32rpx -10rpx rgba(111, 90, 224, 0.6);
}

.primary::after {
  border: none;
}

/* ---------- 提示 / 空态 ---------- */
.notice,
.empty {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #6b6580;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.error {
  background: #fbe6f0;
  color: #b23a78;
  box-shadow: none;
}

/* ---------- 搭配方案卡片 ---------- */
.plan {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.plan-title {
  display: block;
  margin-bottom: 12rpx;
  color: #221c3a;
  font-size: 32rpx;
  font-weight: 700;
}

.reason {
  display: block;
  color: #6b6580;
  font-size: 26rpx;
  line-height: 1.6;
}

.cautions {
  display: grid;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f3e08a;
  color: #6b5310;
  font-size: 24rpx;
}

.garment-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.garment {
  padding: 16rpx;
  border-radius: 24rpx;
  background: #e1d9f6;
  box-sizing: border-box;
}

.photo {
  width: 100%;
  height: 220rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.55);
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(34, 26, 58, 0.4);
  font-size: 24rpx;
}

.garment-name,
.meta {
  display: block;
  padding: 0 6rpx;
}

.garment-name {
  margin-top: 14rpx;
  color: #2e2742;
  font-size: 28rpx;
  font-weight: 600;
}

.meta {
  margin-top: 6rpx;
  color: rgba(46, 39, 66, 0.55);
  font-size: 24rpx;
}

.save {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #6f5ae0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.save::after {
  border: none;
}
