.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 160rpx;
  background: #eceaf0;
  box-sizing: border-box;
}

/* ---------- 顶部标题 ---------- */
.head {
  padding: 12rpx 4rpx 0;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #221c3a;
  letter-spacing: -1rpx;
}

.page-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9a94ac;
}

/* ---------- 输入面板 ---------- */
.panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.title {
  display: block;
  margin-bottom: 16rpx;
  color: #221c3a;
  font-size: 30rpx;
  font-weight: 700;
}

.weather-card {
  margin-bottom: 26rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #f7f6fb;
}

.weather-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx 16rpx;
}

.weather-city,
.weather-unavailable,
.weather-hourly-title {
  color: #6b6580;
  font-size: 24rpx;
}

.weather-modes {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 16rpx;
}

.weather-mode {
  height: 64rpx;
  margin: 0;
  border: 2rpx solid #e4e0ef;
  border-radius: 14rpx;
  background: #fff;
  color: #6b6580;
  font-size: 24rpx;
  line-height: 60rpx;
}

.weather-mode::after {
  border: none;
}

.weather-mode.active {
  border-color: #6f5ae0;
  background: #6f5ae0;
  color: #fff;
}

.weather-basis {
  display: grid;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #2e2742;
  font-size: 26rpx;
}

.weather-hourly {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  gap: 6rpx;
  color: #6f5ae0;
  font-size: 22rpx;
  text-align: center;
}

.weather-hour {
  display: grid;
  gap: 4rpx;
}

.weather-unavailable {
  margin-top: 18rpx;
  color: #9a5d24;
}

.prompt {
  width: 100%;
  min-height: 160rpx;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  background: #f7f6fb;
  color: #221c3a;
  font-size: 28rpx;
  box-sizing: border-box;
}

.primary {
  margin-top: 22rpx;
  height: 92rpx;
  border-radius: 20rpx;
  background: #6f5ae0;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
  box-shadow: 0 16rpx 32rpx -10rpx rgba(111, 90, 224, 0.6);
}

.primary::after {
  border: none;
}

/* ---------- 提示 / 空态 ---------- */
.notice,
.empty {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #6b6580;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.error {
  background: #fbe6f0;
  color: #b23a78;
  box-shadow: none;
}

/* ---------- 搭配方案卡片 ---------- */
.plan {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.plan-title {
  display: block;
  margin-bottom: 12rpx;
  color: #221c3a;
  font-size: 32rpx;
  font-weight: 700;
}

.reason {
  display: block;
  color: #6b6580;
  font-size: 26rpx;
  line-height: 1.6;
}

.cautions {
  display: grid;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f3e08a;
  color: #6b5310;
  font-size: 24rpx;
}

.garment-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.garment {
  padding: 16rpx;
  border-radius: 24rpx;
  background: #e1d9f6;
  box-sizing: border-box;
}

.photo {
  width: 100%;
  height: 220rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.55);
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(34, 26, 58, 0.4);
  font-size: 24rpx;
}

.garment-name,
.meta {
  display: block;
  padding: 0 6rpx;
}

.garment-name {
  margin-top: 14rpx;
  color: #2e2742;
  font-size: 28rpx;
  font-weight: 600;
}

.meta {
  margin-top: 6rpx;
  color: rgba(46, 39, 66, 0.55);
  font-size: 24rpx;
}

.status-label {
  display: inline-block;
  margin: 10rpx 6rpx 0;
  padding: 6rpx 10rpx;
  border-radius: 10rpx;
  background: #fff1d6;
  color: #9a5d24;
  font-size: 22rpx;
}

.save {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #6f5ae0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.save::after {
  border: none;
}

/* ---------- 搭配反馈 ---------- */
.feedback {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f7f6fb;
}

.feedback-title {
  display: block;
  color: #221c3a;
  font-size: 28rpx;
  font-weight: 700;
}

.feedback-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.feedback-option {
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: #fff;
  border: 2rpx solid #e4e0ef;
  color: #6b6580;
  font-size: 26rpx;
  text-align: center;
}

.feedback-option.active {
  background: #6f5ae0;
  border-color: #6f5ae0;
  color: #fff;
  font-weight: 600;
}

.feedback-input {
  width: 100%;
  min-height: 120rpx;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #fff;
  border: 2rpx solid #e4e0ef;
  color: #221c3a;
  font-size: 26rpx;
  box-sizing: border-box;
}

.feedback-submit {
  margin-top: 18rpx;
  height: 80rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 2rpx solid #6f5ae0;
  color: #6f5ae0;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.feedback-submit::after {
  border: none;
}

.feedback-done {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: #e6f5e9;
  color: #2f7d43;
  font-size: 26rpx;
}
