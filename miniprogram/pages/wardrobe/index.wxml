<view class="page">
  <view class="head">
    <view class="head-text">
      <text class="page-title">衣橱</text>
      <text class="page-sub">{{allGarments.length}} 件 · 今天想穿什么？</text>
    </view>
    <view class="head-icon" bindtap="retryLoad">
      <view class="search-glass"></view>
    </view>
  </view>

  <view class="ai-banner" bindtap="goToDaily">
    <view class="ai-dot ai-dot-1"></view>
    <view class="ai-dot ai-dot-2"></view>
    <view class="ai-dot ai-dot-3"></view>
    <text class="ai-eyebrow">今日 AI 推荐</text>
    <text class="ai-headline">让 AI 帮你搭配</text>
    <text class="ai-desc">根据你衣橱里的衣物，生成适合今天的穿搭。</text>
    <view class="ai-cta">查看搭配</view>
  </view>

  <view class="quick-actions">
    <button class="secondary-action" loading="{{importing}}" bindtap="chooseBulkImport">批量导入</button>
    <button class="secondary-action" loading="{{importingBackup}}" bindtap="chooseBackupImport">导入备份</button>
    <button class="secondary-action" loading="{{exporting}}" bindtap="exportWardrobeBackup">导出备份</button>
    <button class="secondary-action" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:if="{{importProgress}}" class="notice progress-card">{{importProgress}}</view>
  <view wx:if="{{deleteMode}}" class="delete-hint">已选择 {{selectedGarmentIds.length}} 件，继续点选卡片可多选。</view>

  <view wx:if="{{error}}" class="notice error-card">
    <text class="error-title">服务器连接失败</text>
    <text class="error-text">{{error}}</text>
    <button class="retry" loading="{{loading}}" bindtap="retryLoad">重试</button>
  </view>
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{!error && garments.length === 0}}" class="empty">
    <text class="empty-title">还没有衣物</text>
    <text class="empty-text">先添加第一件衣物，小程序就能开始显示你的衣橱。</text>
    <button class="primary" bindtap="goToAdd">添加第一件衣物</button>
  </view>

  <view wx:else>
    <view class="filters">
      <picker mode="selector" range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="filter-chip {{categoryIndex ? 'filter-chip-active' : ''}}">{{categoryOptions[categoryIndex].label}}</view>
      </picker>
      <picker mode="selector" range="{{seasonOptions}}" range-key="label" value="{{seasonIndex}}" bindchange="onSeasonChange">
        <view class="filter-chip {{seasonIndex ? 'filter-chip-active' : ''}}">{{seasonOptions[seasonIndex].label}}</view>
      </picker>
      <button wx:if="{{activeFilterCount}}" class="clear-filter" bindtap="clearFilters">清空</button>
    </view>

    <view wx:if="{{filteredGarments.length === 0}}" class="empty filtered-empty">
      <text class="empty-title">没有符合条件的衣物</text>
      <text class="empty-text">换一个分类或季节试试。</text>
      <button class="primary" bindtap="clearFilters">清空筛选</button>
    </view>

    <view wx:else class="grid">
    <view
      wx:for="{{filteredGarments}}"
      wx:key="id"
      class="card {{item.tintClass}} {{selectedGarmentMap[item.id] ? 'selected-card' : ''}}"
      data-id="{{item.id}}"
      bindtap="goToDetail"
      bindlongpress="enterDeleteMode"
    >
      <view wx:if="{{deleteMode}}" class="select-mark {{selectedGarmentMap[item.id] ? 'checked' : ''}}">
        {{selectedGarmentMap[item.id] ? '✓' : ''}}
      </view>
      <image wx:if="{{item.photoUrl}}" class="photo" src="{{item.photoUrl}}" mode="aspectFill" />
      <view wx:else class="photo placeholder">暂无图片</view>
      <view class="card-info">
        <text class="name">{{item.name || item.categoryLabel}}</text>
        <text class="meta">{{item.categoryLabel}} · {{item.colorLabel}}</text>
      </view>
    </view>
    </view>
  </view>

  <view wx:if="{{!deleteMode}}" class="fab" bindtap="goToAdd">+</view>
  <view wx:else class="delete-bar">
    <button class="cancel-delete" disabled="{{bulkDeleting}}" bindtap="cancelDeleteMode">取消</button>
    <button
      class="confirm-delete"
      loading="{{bulkDeleting}}"
      disabled="{{selectedGarmentIds.length === 0}}"
      bindtap="confirmBulkDelete"
    >
      删除 {{selectedGarmentIds.length}} 件
    </button>
  </view>
</view>
