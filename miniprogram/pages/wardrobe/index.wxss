.page {
  min-height: 100vh;
  padding: 32rpx;
  background: linear-gradient(180deg, #f7f2e8 0%, #edf4ef 100%);
  box-sizing: border-box;
}

.hero {
  padding: 36rpx 28rpx;
  border-radius: 32rpx;
  background: #26362d;
  color: #fff8e8;
  box-shadow: 0 18rpx 42rpx rgba(38, 54, 45, 0.18);
}

.eyebrow {
  display: block;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  opacity: 0.72;
}

.title {
  display: block;
  margin-top: 12rpx;
  font-size: 56rpx;
  font-weight: 700;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.82;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.secondary-action {
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #26362d;
  font-size: 28rpx;
}

.notice,
.loading,
.empty {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.84);
}

.error-card {
  background: #fff7f2;
}

.error-title,
.error-text {
  display: block;
}

.error-title {
  color: #9d3f22;
  font-size: 32rpx;
  font-weight: 700;
}

.error-text {
  margin-top: 10rpx;
  color: #7f5f52;
  font-size: 26rpx;
  line-height: 1.5;
}

.retry {
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #d96c3f;
  color: #fff;
}

.empty-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #26362d;
}

.empty-text {
  display: block;
  margin: 14rpx 0 28rpx;
  color: #6d756f;
  line-height: 1.6;
}

.primary,
.fab {
  background: #d96c3f;
  color: #fff;
}

.filters {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-chip,
.clear-filter {
  min-width: 152rpx;
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #26362d;
  font-size: 26rpx;
  line-height: 68rpx;
  text-align: center;
  box-sizing: border-box;
}

.clear-filter {
  min-width: 112rpx;
  color: #9d3f22;
}

.filtered-empty {
  margin-top: 24rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-top: 28rpx;
  padding-bottom: 120rpx;
}

.card {
  overflow: hidden;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 12rpx 30rpx rgba(54, 66, 58, 0.12);
}

.photo {
  width: 100%;
  height: 280rpx;
  background: #e4dfd2;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7d766a;
  font-size: 26rpx;
}

.name,
.meta {
  display: block;
  padding: 0 20rpx;
}

.name {
  margin-top: 18rpx;
  color: #26362d;
  font-size: 30rpx;
  font-weight: 700;
}

.meta {
  margin: 8rpx 0 20rpx;
  color: #727a72;
  font-size: 24rpx;
}

.fab {
  position: fixed;
  right: 34rpx;
  bottom: 48rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  font-size: 56rpx;
  line-height: 108rpx;
  box-shadow: 0 14rpx 34rpx rgba(217, 108, 63, 0.34);
}
