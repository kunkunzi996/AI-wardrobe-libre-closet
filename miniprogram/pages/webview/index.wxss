.setup {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.panel {
  width: 100%;
  padding: 40rpx;
  border: 1rpx solid #dedbd2;
  border-radius: 12rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.title {
  margin-bottom: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.body,
.hint {
  color: #4f5355;
  font-size: 28rpx;
  line-height: 1.6;
}

.hint {
  margin-top: 20rpx;
}
