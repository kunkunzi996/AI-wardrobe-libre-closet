<view class="admin-page">
  <view class="header">
    <text class="title">库存管理</text>
    <text class="subtitle">按用户查看库存、导出、补标签，并把衣橱复制到验收沙盒</text>
  </view>

  <view wx:if="{{error}}" class="notice error-card">
    <text class="error-title">加载失败</text>
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" loading="{{loading}}" bindtap="retryLoad">重试</button>
  </view>

  <view wx:elif="{{loading}}" class="notice">
    <text class="loading-text">正在加载…</text>
  </view>

  <view wx:elif="{{users.length === 0}}" class="notice">
    <text class="loading-text">暂无用户</text>
  </view>

  <view wx:else class="user-list">
    <view wx:for="{{users}}" wx:key="id" class="user-card">
      <view class="user-main">
        <text class="user-name">{{item.displayName}}</text>
        <text class="user-meta">用户ID: {{item.id}}</text>
        <text wx:if="{{item.wechatOpenIdMasked}}" class="user-meta">微信: {{item.wechatOpenIdMasked}}</text>
        <text wx:if="{{item.acceptanceSandbox}}" class="sandbox-badge">验收沙盒</text>
        <button
          wx:else
          class="sandbox-btn"
          loading="{{markingUserId === item.id}}"
          disabled="{{copying}}"
          data-id="{{item.id}}"
          bindtap="markAcceptanceSandbox"
        >
          设为验收沙盒
        </button>
      </view>
      <view class="user-side">
        <text class="count">{{item.garmentCount}}</text>
        <text class="count-label">件</text>
        <button
          class="export-btn"
          loading="{{exportingUserId === item.id}}"
          disabled="{{backfillingUserId === item.id}}"
          data-id="{{item.id}}"
          bindtap="exportUserInventory"
        >
          导出
        </button>
        <button
          class="backfill-btn"
          loading="{{backfillingUserId === item.id}}"
          disabled="{{backfillingUserId !== null}}"
          data-id="{{item.id}}"
          bindtap="backfillUserTags"
        >
          AI补标签
        </button>
      </view>
    </view>

    <view class="copy-card">
      <text class="copy-title">衣橱复制</text>
      <text class="copy-hint">先选源衣橱和验收沙盒，确认件数后再写入。</text>
      <picker
        mode="selector"
        range="{{users}}"
        range-key="displayName"
        value="{{sourceIndex}}"
        bindchange="onSourceChange"
      >
        <view class="copy-picker">源 sourceUserId：{{sourceUserId || '未选'}}</view>
      </picker>
      <picker
        mode="selector"
        range="{{sandboxUsers}}"
        range-key="displayName"
        value="{{targetIndex}}"
        bindchange="onTargetChange"
      >
        <view class="copy-picker">沙盒 targetUserId：{{targetUserId || '未选'}}</view>
      </picker>
      <view wx:if="{{preview}}" class="copy-preview">
        <text>源衣物 garmentCount：{{preview.source.garmentCount}}</text>
        <text>源照片：{{preview.source.photoCount}} 源搭配：{{preview.source.outfitCount}}</text>
        <text>今日穿搭：{{preview.source.calendarCount}} 反馈：{{preview.source.feedbackCount}}</text>
        <text>目标现有衣物：{{preview.target.garmentCount}}</text>
      </view>
      <button
        class="copy-btn"
        loading="{{copying}}"
        disabled="{{copying || !sourceUserId || !targetUserId}}"
        bindtap="previewAndCopy"
      >
        预览并复制
      </button>
    </view>
  </view>

  <view wx:if="{{copyResult}}" class="result-mask">
    <view class="result-dialog">
      <view class="result-header">
        <text class="result-title">衣橱复制结果</text>
        <text class="result-state">{{copyResult.complete ? '副本已拷全，且对上沙盒衣服' : '副本未拷全或未对上'}}</text>
      </view>
      <view class="result-body">
        <view class="result-grid">
          <view class="result-metric">
            <text class="result-value">{{copyResult.copied.garments}}</text>
            <text class="result-label">衣物</text>
          </view>
          <view class="result-metric">
            <text class="result-value">{{copyResult.copied.photos}}</text>
            <text class="result-label">照片</text>
          </view>
          <view class="result-metric">
            <text class="result-value">{{copyResult.copied.outfits}}</text>
            <text class="result-label">搭配</text>
          </view>
          <view class="result-metric">
            <text class="result-value">{{copyResult.copied.calendars}}</text>
            <text class="result-label">今日穿搭</text>
          </view>
          <view class="result-metric">
            <text class="result-value">{{copyResult.copied.feedback}}</text>
            <text class="result-label">反馈</text>
          </view>
        </view>
        <view class="copy-matched">
          <text>搭配槽位对上：{{copyResult.matched.outfitSlotsMapped}}/{{copyResult.matched.outfitSlots}}</text>
          <text>今日穿搭对上：{{copyResult.matched.calendarsMapped}}/{{copyResult.matched.calendars}}</text>
          <text>反馈衣物对上：{{copyResult.matched.feedbackGarmentIdsMapped}}/{{copyResult.matched.feedbackGarmentIds}}</text>
        </view>
      </view>
      <button class="result-close" bindtap="closeCopyResult">关闭</button>
    </view>
  </view>

  <view wx:if="{{backfillResult}}" class="result-mask">
    <view class="result-dialog">
      <view class="result-header">
        <text class="result-title">本批补标签结果</text>
        <text class="result-state">{{backfillResult.completionText}}</text>
      </view>
      <scroll-view scroll-y class="result-body">
        <view class="result-grid">
          <view class="result-metric">
            <text class="result-value">{{backfillResult.analyzedThisRun}}</text>
            <text class="result-label">本次分析</text>
          </view>
          <view class="result-metric">
            <text class="result-value">{{backfillResult.filledFieldCount}}</text>
            <text class="result-label">新增标签</text>
          </view>
          <view class="result-metric">
            <text class="result-value">{{backfillResult.remainingUnattempted}}</text>
            <text class="result-label">仍待处理</text>
          </view>
          <view class="result-metric">
            <text class="result-value">{{backfillResult.unreadableCount + backfillResult.failedCount}}</text>
            <text class="result-label">未识别或失败</text>
          </view>
        </view>
        <view class="result-row">
          <text>无照片：{{backfillResult.noPhotoCount}} 件</text>
          <text>镜像冲突：{{backfillResult.mirrorConflictCount}} 项</text>
        </view>
        <view wx:if="{{backfillResult.deadlineReached}}" class="result-notice">
          <text>本批已到时间预算，剩余衣物可再次处理。</text>
        </view>
        <view wx:if="{{backfillResult.noPhotoItems.length}}" class="result-list">
          <text class="result-list-title">无照片衣物</text>
          <text
            wx:for="{{backfillResult.noPhotoItems}}"
            wx:key="id"
            class="result-list-item"
          >
            #{{item.id}} {{item.name}}
          </text>
          <text wx:if="{{backfillResult.noPhotoItemsTruncated}}" class="result-note">
            清单超过 500 件，当前只显示前 500 件。
          </text>
        </view>
        <view wx:if="{{backfillResult.failedItems.length}}" class="result-list">
          <text class="result-list-title">未识别或失败</text>
          <text
            wx:for="{{backfillResult.failedItems}}"
            wx:key="id"
            class="result-list-item"
          >
            #{{item.id}} {{item.name}}：{{item.reasonLabel}}
          </text>
        </view>
      </scroll-view>
      <button class="result-close" bindtap="closeBackfillResult">关闭</button>
    </view>
  </view>
</view>
