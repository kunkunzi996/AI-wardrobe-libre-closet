.admin-page {
  min-height: 100vh;
  padding: 36rpx 32rpx 80rpx;
  background: #eceaf0;
  box-sizing: border-box;
  font-family: "Notion Sans", "Inter", "PingFang SC", -apple-system,
    BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
}

.header {
  padding: 16rpx 0 28rpx;
}

.title,
.subtitle {
  display: block;
}

.title {
  color: #221c3a;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.25;
}

.subtitle {
  margin-top: 8rpx;
  color: #6b6580;
  font-size: 28rpx;
  line-height: 1.5;
}

.notice {
  padding: 32rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.error-card {
  background: #fbe6f0;
  box-shadow: none;
}

.error-title,
.error-text,
.loading-text {
  display: block;
}

.error-title {
  color: #c0392b;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.error-text,
.loading-text {
  margin-top: 10rpx;
  color: #6b6580;
  font-size: 28rpx;
  line-height: 1.5;
}

.retry-btn,
.export-btn,
.backfill-btn,
.sandbox-btn,
.copy-btn,
.result-close {
  border-radius: 18rpx;
}

.retry-btn::after,
.export-btn::after,
.backfill-btn::after,
.sandbox-btn::after,
.copy-btn::after,
.result-close::after {
  border: none;
}

.retry-btn {
  height: 72rpx;
  margin-top: 22rpx;
  background: #6f5ae0;
  color: #fff;
  font-size: 28rpx;
  line-height: 72rpx;
}

.user-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.user-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 164rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
  box-sizing: border-box;
}

.user-main {
  min-width: 0;
  padding-right: 20rpx;
}

.user-name,
.user-meta {
  display: block;
}

.user-name {
  color: #221c3a;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.user-meta {
  margin-top: 6rpx;
  color: #6b6580;
  font-size: 24rpx;
  line-height: 1.45;
}

.user-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 152rpx;
}

.count {
  color: #2a9d99;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1;
}

.count-label {
  margin-top: 4rpx;
  color: #6b6580;
  font-size: 22rpx;
  line-height: 1.2;
}

.export-btn {
  width: 120rpx;
  height: 60rpx;
  margin-top: 14rpx;
  padding: 0;
  background: #f5d75e;
  color: #221c3a;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 60rpx;
}

.backfill-btn {
  width: 136rpx;
  height: 60rpx;
  margin-top: 12rpx;
  padding: 0;
  background: #2a9d99;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 60rpx;
}

.export-btn[disabled],
.backfill-btn[disabled],
.sandbox-btn[disabled],
.copy-btn[disabled] {
  opacity: 0.52;
}

.sandbox-badge,
.sandbox-btn {
  margin-top: 10rpx;
}

.sandbox-badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: #e8f6f5;
  color: #2a9d99;
  font-size: 22rpx;
  line-height: 1.4;
}

.sandbox-btn {
  height: 52rpx;
  margin: 10rpx 0 0;
  padding: 0 16rpx;
  background: #6f5ae0;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.copy-card {
  margin-top: 8rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.copy-title,
.copy-hint,
.copy-picker,
.copy-preview text {
  display: block;
}

.copy-title {
  color: #221c3a;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
}

.copy-hint {
  margin-top: 8rpx;
  color: #6b6580;
  font-size: 24rpx;
  line-height: 1.45;
}

.copy-picker {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f5f3fa;
  color: #221c3a;
  font-size: 26rpx;
}

.copy-preview {
  margin-top: 16rpx;
  color: #4e4960;
  font-size: 24rpx;
  line-height: 1.5;
}

.copy-btn {
  height: 72rpx;
  margin-top: 22rpx;
  background: #6f5ae0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.result-mask {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(20, 17, 31, 0.42);
  box-sizing: border-box;
}

.result-dialog {
  display: flex;
  width: 100%;
  max-height: 80vh;
  flex-direction: column;
  border-radius: 20rpx;
  background: #fff;
  overflow: hidden;
}

.result-header {
  padding: 30rpx 30rpx 18rpx;
  border-bottom: 1rpx solid #ece8f2;
}

.result-title,
.result-state,
.result-list-title,
.result-list-item,
.result-note {
  display: block;
}

.result-title {
  color: #221c3a;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.35;
}

.result-state {
  margin-top: 8rpx;
  color: #6b6580;
  font-size: 25rpx;
  line-height: 1.45;
}

.result-body {
  max-height: 800rpx;
  padding: 26rpx 30rpx;
  box-sizing: border-box;
}

.result-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.result-metric {
  min-width: 0;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f5f3fa;
}

.result-value,
.result-label {
  display: block;
}

.result-value {
  color: #221c3a;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.1;
}

.result-label {
  margin-top: 7rpx;
  color: #6b6580;
  font-size: 22rpx;
  line-height: 1.3;
}

.result-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
  color: #4e4960;
  font-size: 24rpx;
  line-height: 1.45;
}

.result-notice {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #fff4ce;
  color: #665418;
  font-size: 24rpx;
  line-height: 1.45;
}

.result-list {
  margin-top: 24rpx;
}

.result-list-title {
  color: #221c3a;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.result-list-item {
  margin-top: 10rpx;
  color: #4e4960;
  font-size: 24rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.result-note {
  margin-top: 12rpx;
  color: #9a6d00;
  font-size: 22rpx;
  line-height: 1.4;
}

.result-close {
  height: 76rpx;
  margin: 0;
  border-radius: 0;
  background: #6f5ae0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 76rpx;
}
