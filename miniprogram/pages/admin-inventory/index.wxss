.admin-page {
  min-height: 100vh;
  padding: 36rpx 32rpx 80rpx;
  background: #eceaf0;
  box-sizing: border-box;
  font-family: "Notion Sans", "Inter", "PingFang SC", -apple-system,
    BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
}

.header {
  padding: 16rpx 0 28rpx;
}

.title,
.subtitle {
  display: block;
}

.title {
  color: #221c3a;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.25;
}

.subtitle {
  margin-top: 8rpx;
  color: #6b6580;
  font-size: 28rpx;
  line-height: 1.5;
}

.notice {
  padding: 32rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.error-card {
  background: #fbe6f0;
  box-shadow: none;
}

.error-title,
.error-text,
.loading-text {
  display: block;
}

.error-title {
  color: #c0392b;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.error-text,
.loading-text {
  margin-top: 10rpx;
  color: #6b6580;
  font-size: 28rpx;
  line-height: 1.5;
}

.retry-btn,
.export-btn {
  border-radius: 18rpx;
}

.retry-btn::after,
.export-btn::after {
  border: none;
}

.retry-btn {
  height: 72rpx;
  margin-top: 22rpx;
  background: #6f5ae0;
  color: #fff;
  font-size: 28rpx;
  line-height: 72rpx;
}

.user-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.user-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 164rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
  box-sizing: border-box;
}

.user-main {
  min-width: 0;
  padding-right: 20rpx;
}

.user-name,
.user-meta {
  display: block;
}

.user-name {
  color: #221c3a;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.user-meta {
  margin-top: 6rpx;
  color: #6b6580;
  font-size: 24rpx;
  line-height: 1.45;
}

.user-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 132rpx;
}

.count {
  color: #2a9d99;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1;
}

.count-label {
  margin-top: 4rpx;
  color: #6b6580;
  font-size: 22rpx;
  line-height: 1.2;
}

.export-btn {
  width: 120rpx;
  height: 60rpx;
  margin-top: 14rpx;
  padding: 0;
  background: #f5d75e;
  color: #221c3a;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 60rpx;
}
