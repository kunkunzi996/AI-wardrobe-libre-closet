.profile-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: #eceaf0;
  font-family: "Notion Sans", "Inter", "PingFang SC", -apple-system,
    BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  box-sizing: border-box;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 32rpx;
  background: #545e7c;
  color: #fff;
  box-sizing: border-box;
}

.top-title {
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.25;
}

.menu-icon,
.settings-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.menu-icon {
  flex-direction: column;
  gap: 8rpx;
}

.menu-icon view {
  width: 32rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #fff;
}

.settings-icon {
  position: relative;
}

.settings-icon::before {
  content: "";
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  box-sizing: border-box;
}

.gear-dot {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #fff;
}

.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 44rpx 48rpx;
  overflow: hidden;
  background: #545e7c;
  color: #fff;
  text-align: center;
}

.decor {
  position: absolute;
  opacity: 0.75;
}

.decor-pink {
  top: 18rpx;
  left: 80rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: #ff64c8;
  transform: rotate(12deg);
}

.decor-yellow {
  right: 98rpx;
  bottom: 80rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f5d75e;
}

.decor-teal {
  top: 92rpx;
  right: 180rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 6rpx;
  background: #2a9d99;
  transform: rotate(45deg);
}

.avatar-wrap {
  position: relative;
  z-index: 1;
  margin-bottom: 22rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border: 8rpx solid #ebe6f2;
  border-radius: 50%;
  background: linear-gradient(145deg, #f9d6e6, #d9e7fb);
  box-shadow: 0 10rpx 24rpx rgba(34, 26, 58, 0.18);
}

.avatar text {
  color: #5746d5;
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.15;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.status-dot {
  position: absolute;
  right: 6rpx;
  bottom: 4rpx;
  width: 42rpx;
  height: 42rpx;
  border: 5rpx solid #545e7c;
  border-radius: 50%;
  background: #1aae39;
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-align: center;
  box-sizing: border-box;
}

.name {
  position: relative;
  z-index: 1;
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: 0;
}

.bio {
  position: relative;
  z-index: 1;
  max-width: 560rpx;
  margin-top: 12rpx;
  color: #ebe6f2;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
}

.edit-btn {
  position: relative;
  z-index: 1;
  height: 72rpx;
  margin-top: 28rpx;
  padding: 0 34rpx;
  border-radius: 18rpx;
  background: #f6f2fe;
  color: #221c3a;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 72rpx;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.08);
}

.edit-btn::after,
.retry-btn::after,
.logout-btn::after {
  border: none;
}

.stats-section {
  position: relative;
  z-index: 2;
  margin-top: 0;
  padding: 0 32rpx;
}

.section-title {
  display: block;
  padding-top: 24rpx;
  margin-bottom: 24rpx;
  color: #221c3a;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.total-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #d4eedd;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.total-title,
.total-desc {
  display: block;
}

.total-title {
  color: #221c3a;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.25;
}

.total-desc {
  margin-top: 6rpx;
  color: #5d5b54;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
}

.inventory-mark {
  width: 58rpx;
  height: 58rpx;
  border: 8rpx solid rgba(42, 157, 153, 0.22);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 18rpx;
}

.stat-card {
  min-height: 156rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
  box-sizing: border-box;
}

.stat-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
}

.stat-icon::after {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  background: currentColor;
}

.icon-top {
  color: #7b3ff2;
}

.icon-bottom {
  color: #dd5b00;
}

.icon-shoes {
  color: #2a9d99;
}

.icon-accessory {
  color: #b23a78;
}

.stat-text {
  display: block;
  color: #221c3a;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.notice {
  padding: 32rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.error-card {
  background: #fbe6f0;
  box-shadow: none;
}

.error-title,
.error-text {
  display: block;
}

.error-title {
  color: #c0392b;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.error-text {
  margin-top: 10rpx;
  color: #8a5a6e;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
}

.retry-btn {
  height: 72rpx;
  margin-top: 22rpx;
  border-radius: 18rpx;
  background: #6f5ae0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 72rpx;
}

.menu-card {
  margin: 28rpx 32rpx 0;
  overflow: hidden;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(34, 26, 58, 0.05);
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #e5e3df;
  box-sizing: border-box;
}

.menu-row.last {
  border-bottom: none;
}

.row-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: #221c3a;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1.55;
}

.row-icon {
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
}

.row-wardrobe {
  border: 4rpx solid #6b6580;
  border-radius: 8rpx;
}

.row-outfit {
  border: 4rpx solid #6b6580;
  border-radius: 7rpx;
  transform: rotate(45deg);
}

.row-settings {
  border: 4rpx solid #6b6580;
  border-radius: 50%;
}

.row-export {
  border: 4rpx solid #6b6580;
  border-radius: 6rpx;
  border-top-style: dashed;
}

.row-admin {
  position: relative;
  border: 4rpx solid #6b6580;
  border-radius: 8rpx;
}

.row-admin::after {
  content: "";
  position: absolute;
  left: 7rpx;
  right: 7rpx;
  bottom: 7rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #6b6580;
}

.chevron {
  color: #c8c4d7;
  font-size: 48rpx;
  line-height: 1;
}

.logout-btn {
  height: 72rpx;
  margin: 28rpx auto 0;
  padding: 0 34rpx;
  border-radius: 18rpx;
  background: transparent;
  color: #c0392b;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 72rpx;
}
