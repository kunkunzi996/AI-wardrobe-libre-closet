<view class="page">
  <view class="head">
    <text class="eyebrow">PROFILE</text>
    <text class="title">编辑资料</text>
  </view>

  <view class="section avatar-section">
    <view class="avatar-picker" bindtap="chooseAvatar">
      <image
        wx:if="{{avatarPath || avatarUrl}}"
        class="avatar-image"
        src="{{avatarPath || avatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="avatar-empty">
        <text class="avatar-word">衣</text>
      </view>
    </view>
    <text class="avatar-action">点击更换头像</text>
    <text class="hint">头像会原样保存，不会做衣物抠图。</text>
  </view>

  <view class="section">
    <text class="label">昵称</text>
    <input
      class="input"
      maxlength="32"
      placeholder="例如：昆昆子"
      value="{{nickname}}"
      bindinput="onNicknameInput"
    />
  </view>

  <view class="section">
    <text class="label">签名</text>
    <textarea
      class="textarea"
      maxlength="120"
      placeholder="写一句你的穿搭态度"
      value="{{bio}}"
      bindinput="onBioInput"
    />
  </view>

  <button class="save" loading="{{saving}}" disabled="{{loading || saving}}" bindtap="save">保存</button>
</view>
